            result.push({property: fields[i], expression: prop.expression, enabled: true});
        }
        return result;
    }
    function validatePlan(plan, options) {
        options = options || {};
        if (!plan || plan.version !== 1) { fail("Plan version must be 1."); }
        if (typeof plan.cut_number !== "string" || !/^\d+$/.test(plan.cut_number)) { fail("cut_number must be a digit string."); }
        if (!finite(plan.fps) || plan.fps <= 0 || !integer(plan.total_frames) || plan.total_frames < 1) { fail("Invalid fps or total_frames."); }
        if (!nonempty(plan.stage_name) || !nonempty(plan.camera_layer)) { fail("stage_name and camera_layer are required."); }
        var layoutParts = typeof plan.layout_source === "string" ? plan.layout_source.replace(/\\/g, "/").split("/") : [];
        if (layoutParts.length !== 2 || layoutParts[0].toLowerCase() !== String(options.loSourceFolder || "LO").toLowerCase() || !nonempty(layoutParts[1]) ||
                layoutParts[1] === "." || layoutParts[1] === ".." || /[<>:"|?*]/.test(layoutParts[1])) {
            fail("layout_source must be a direct scene-relative LO/filename path.");
        }
        if (!isArray(plan.image_size) || plan.image_size.length !== 2 ||
                !integer(plan.image_size[0]) || !integer(plan.image_size[1]) || plan.image_size[0] < 1 || plan.image_size[1] < 1) {
            fail("image_size must contain two positive integers.");
        }
        if (plan.replace_existing !== undefined && typeof plan.replace_existing !== "boolean") { fail("replace_existing must be boolean."); }
        if (!isArray(plan.keys) || !plan.keys.length) { fail("At least one reviewed camera key is required."); }
        var previous = 0;
        for (var i = 0; i < plan.keys.length; i++) {
            var key = plan.keys[i];
            if (!key || !integer(key.frame) || key.frame <= previous || key.frame > plan.total_frames) {
                fail("Camera frames must be unique, increasing integers in the 1-based cut range.");
            }
            if (!nonempty(key.label)) { fail("Each reviewed rectangle needs a label."); }
            if (key.slow !== undefined && typeof key.slow !== "boolean") { fail("slow must be boolean when present."); }
            if (i === 0 && key.slow === true) { fail("The first camera key cannot be slow."); }
            var rect = key.rect;
            if (!isArray(rect) || rect.length !== 4 || !finite(rect[0]) || !finite(rect[1]) || !finite(rect[2]) || !finite(rect[3]) ||
                    rect[0] < 0 || rect[1] < 0 || rect[2] > plan.image_size[0] || rect[3] > plan.image_size[1] ||
                    rect[0] >= rect[2] || rect[1] >= rect[3]) {
                fail("Rectangle must be [left, top, right, bottom] within the original image.");
            }
            previous = key.frame;
        }
    }
    function mappedLayoutPath(absolutePath, layoutResult) {
        if (!layoutResult || !layoutResult.sourceMappings) { return absolutePath; }
        var expected = pathKey(absolutePath);
        for (var i = 0; i < layoutResult.sourceMappings.length; i++) {
            var mapping = layoutResult.sourceMappings[i];
            if (mapping && pathKey(mapping.originalSource) === expected && mapping.importSource) { return mapping.importSource; }
        }
        return absolutePath;
    }
    function prepare(project, plan, layoutResult, options) {
        options = options || {};
        validatePlan(plan, options);
        if (!project || !project.file || !project.file.parent) { fail("A saved scene project is required."); }
        if (options.projectPath && pathKey(project.file.fsName) !== pathKey(options.projectPath)) { fail("Project differs from the profiled scene project."); }
        if (options.sceneFolder && pathKey(project.file.parent.fsName) !== pathKey(options.sceneFolder)) { fail("Project folder differs from the profiled scene folder."); }
        if (options.cut !== undefined && parseInt(options.cut, 10) !== parseInt(plan.cut_number, 10)) { fail("Plan CUT differs from the profiled scene cut."); }
        if (options.cut === undefined) {
            var projectName = String(project.file.name || ""), folderName = String(project.file.parent.name || "");
            var projectCut = /DEMO_SC(\d+)(?:\.|$)/i.exec(projectName), folderCut = /^DEMO_SC(\d+)$/i.exec(folderName);
            if (projectCut && parseInt(projectCut[1], 10) === 0) { fail("Never modify the SC000 master template."); }
            if ((projectCut && parseInt(projectCut[1], 10) !== parseInt(plan.cut_number, 10)) ||
                    (folderCut && parseInt(folderCut[1], 10) !== parseInt(plan.cut_number, 10))) { fail("Plan CUT differs from the scene project path."); }
        }
        var stage = findComp(project, plan.stage_name), duration = plan.total_frames / plan.fps;
        if (!close(stage.frameRate, plan.fps) || !close(stage.duration, duration)) { fail("Stage fps or duration differs from the reviewed plan."); }
        requireSquarePixels(stage, "Stage");
        var camera = findNamedLayer(stage, plan.camera_layer);
        require2D(camera, "Camera rig");
        if (camera.locked) { fail("Camera rig is locked; unlock it explicitly before applying."); }
        if (!close(camera.startTime, 0) || camera.inPoint > EPSILON || camera.outPoint + EPSILON < duration) { fail("Camera rig must cover the whole cut without a start offset."); }
        var reviewedPath = project.file.parent.fsName + "/" + plan.layout_source.replace(/\\/g, "/");
        var absolutePath = mappedLayoutPath(reviewedPath, layoutResult);
        var layout = findLayout(stage, absolutePath), source = layout.source;
        require2D(layout, "Layout");
        requireSquarePixels(source, "Layout");
        if (source.width !== plan.image_size[0] || source.height !== plan.image_size[1]) { fail("Reviewed image_size differs from the imported layout source."); }
        if (layout.inPoint > EPSILON || layout.outPoint + EPSILON < duration) { fail("Layout must cover the whole cut."); }
        var loTransform = transform(layout), cameraTransform = transform(camera);
        var loPositionProp = property(loTransform, "ADBE Position", "Layout");
        if (loPositionProp.dimensionsSeparated) { fail("Separated layout position dimensions are not supported."); }
        var loPosition = readVector(staticValue(loPositionProp, "layout Position"), "layout Position");
        var loAnchor = readVector(staticValue(property(loTransform, "ADBE Anchor Point", "Layout"), "layout Anchor Point"), "layout Anchor Point");
        var loScale = readVector(staticValue(property(loTransform, "ADBE Scale", "Layout"), "layout Scale"), "layout Scale");
        var loRotation = staticValue(property(loTransform, "ADBE Rotate Z", "Layout"), "layout Rotation");
        if (!close(loRotation, 0) || loScale[0] <= 0 || loScale[1] <= 0) { fail("Rotated, mirrored, or zero-scale layouts are not supported."); }
        var frame = frameSize(camera, project, options.outputCompName);
        var anchor = readVector(staticValue(property(cameraTransform, "ADBE Anchor Point", "Camera"), "camera Anchor Point"), "camera Anchor Point");
        var rotation = staticValue(property(cameraTransform, "ADBE Rotate Z", "Camera"), "camera Rotation");
        if (!close(rotation, 0) || !close(anchor[0], frame[0] / 2) || !close(anchor[1], frame[1] / 2) ||
