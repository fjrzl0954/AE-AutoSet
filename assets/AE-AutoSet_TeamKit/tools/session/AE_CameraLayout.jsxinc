        require2D(layer, outputName + " stage instance");
        var group = transform(layer), fields = ["ADBE Anchor Point", "ADBE Position", "ADBE Scale", "ADBE Rotate Z"], result = [];
        var cameraReference = 'source.layer("' + cameraName + '")';
        var expected = [
            cameraReference + ".position", cameraReference + ".anchor_point",
            "[10000/" + cameraReference + ".scale[0],10000/" + cameraReference + ".scale[1]]",
            "-" + cameraReference + ".rotation"
