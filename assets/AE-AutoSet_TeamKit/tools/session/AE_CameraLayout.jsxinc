        var position = property(cameraTransform, "ADBE Position", "Camera"), scale = property(cameraTransform, "ADBE Scale", "Camera");
        requireNoExpression(position, "camera Position"); requireNoExpression(scale, "camera Scale");
        if (position.dimensionsSeparated || !position.isSpatial) { fail("Camera Position must be a combined spatial property."); }
        if (!position.canVaryOverTime || !scale.canVaryOverTime) { fail("Camera Position and Scale must support keyframes."); }
        if (!position.isInterpolationTypeValid(KeyframeInterpolationType.LINEAR) || !position.isInterpolationTypeValid(KeyframeInterpolationType.BEZIER) ||
