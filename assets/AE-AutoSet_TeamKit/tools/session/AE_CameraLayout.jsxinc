        for (var i = 0; i < left.length; i++) { if (!close(left[i], right[i])) { return false; } }
        return true;
    }
    function readVector(value, name) {
        if (!value || (value.length !== 2 && value.length !== 3)) { fail(name + " must have two or three components."); }
        var result = [];
        for (var i = 0; i < value.length; i++) {
            if (!finite(value[i])) { fail(name + " contains a non-finite component."); }
            result.push(value[i]);
        }
        return result;
    }
    function findComp(project, name) {
        var result = null;
        for (var i = 1; i <= project.numItems; i++) {
            var item = project.item(i);
            if (item instanceof CompItem && item.name === name) {
                if (result) { fail("Ambiguous composition: " + name); }
                result = item;
            }
        }
        if (!result) { fail("Missing composition: " + name); }
        return result;
    }
    function findNamedLayer(comp, name) {
        var result = null;
        for (var i = 1; i <= comp.numLayers; i++) {
            if (comp.layer(i).name === name) {
                if (result) { fail("Ambiguous layer: " + comp.name + "/" + name); }
                result = comp.layer(i);
            }
        }
        if (!result) { fail("Missing layer: " + comp.name + "/" + name); }
        return result;
    }
    function property(group, matchName, context) {
        var value = group ? group.property(matchName) : null;
        if (!value) { fail("Missing property: " + context + "/" + matchName); }
        return value;
    }
    function transform(layer) { return property(layer, "ADBE Transform Group", layer.name); }
    function requireNoExpression(prop, name) {
        if (prop.expressionEnabled || (typeof prop.expression === "string" && prop.expression.length)) {
            fail("Expressions on " + name + " are not supported and were preserved.");
        }
    }
    function staticValue(prop, name) {
        requireNoExpression(prop, name);
        if (prop.numKeys !== 0) { fail("Animated " + name + " is not supported."); }
        return prop.value;
    }
    function require2D(layer, name) {
        if (layer.threeDLayer || layer.parent) { fail(name + " must be unparented and 2D."); }
        if (typeof CameraLayer !== "undefined" && layer instanceof CameraLayer) { fail("A native 3D camera is not supported."); }
        if (typeof AutoOrientType !== "undefined" && layer.autoOrient !== undefined && layer.autoOrient !== AutoOrientType.NO_AUTO_ORIENT) {
            fail(name + " auto-orientation is not supported.");
        }
    }
    function requireSquarePixels(item, name) {
        if (item.pixelAspect !== undefined && !close(item.pixelAspect, 1)) { fail(name + " must use square pixels."); }
    }
    function frameSize(camera, project, outputName) {
        var effects = property(camera, "ADBE Effect Parade", camera.name), effect = null;
        for (var i = 1; i <= effects.numProperties; i++) {
            var candidate = effects.property(i);
            if (candidate.matchName === "F's Frame") {
                if (effect) { fail("Multiple F's Frame effects are ambiguous."); }
                effect = candidate;
            }
