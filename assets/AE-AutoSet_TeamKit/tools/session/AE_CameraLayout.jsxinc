        var positionValue = readVector(position.value, "camera Position"), scaleValue = readVector(scale.value, "camera Scale");
        if ((positionValue.length === 3 && !close(positionValue[2], 0)) || (scaleValue.length === 3 && !close(scaleValue[2], 100))) {
            fail("Unexpected Z components on the 2D camera rig.");
        }
