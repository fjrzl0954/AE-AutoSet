/*
 * Reviewed layout rectangles -> the existing 2D F's Frame camera rig.
 * ES3 / ExtendScript. No file IO, project lifecycle, or save operations.
 * The caller owns an undo group and must not save after a thrown write error.
 */
var AE_CameraLayout = (function () {
    var EPSILON = 0.00001, SLOW_INFLUENCE = 33.333333;

    function fail(message) { throw new Error("Camera layout: " + message); }
    function finite(value) { return typeof value === "number" && isFinite(value); }
    function integer(value) { return finite(value) && Math.floor(value) === value; }
    function isArray(value) { return Object.prototype.toString.call(value) === "[object Array]"; }
    function close(left, right) { return finite(left) && finite(right) && Math.abs(left - right) <= EPSILON; }
    function nonempty(value) { return typeof value === "string" && /\S/.test(value); }
    function pathKey(value) { return String(value).replace(/\\/g, "/").replace(/\/+$/, "").toLowerCase(); }
    function equalVector(left, right) {
