            var output = findComp(project, outputName || "02_camera");
            return [output.width, output.height];
        }
        var width = staticValue(property(effect, "F's Frame-0001", "F's Frame"), "F's Frame width");
        var height = staticValue(property(effect, "F's Frame-0002", "F's Frame"), "F's Frame height");
        if (!finite(width) || !finite(height) || width <= 0 || height <= 0) { fail("Invalid F's Frame size."); }
        return [width, height];
    }
    function findLayout(stage, absolutePath) {
        var result = null, expected = pathKey(absolutePath);
        for (var i = 1; i <= stage.numLayers; i++) {
