            ok: true, status: "validated", cut_number: plan.cut_number, fps: plan.fps, total_frames: plan.total_frames,
            stage: stage.name, camera_layer: camera.name, layout_source: source.file.fsName, reviewed_layout_source: reviewedPath,
            used_rgb_copy: pathKey(absolutePath) !== pathKey(reviewedPath), image_size: plan.image_size.slice(0),
            frame_size: frame, keys: keys, previous_key_counts: {position: position.numKeys, scale: scale.numKeys},
            replaced_existing: false, preserved_output_expressions: expressions
