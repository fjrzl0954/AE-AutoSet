        for (i = 0; i < fields.length; i++) {
            var prop = property(group, fields[i], outputName + " stage instance");
            if (!prop.expressionEnabled || !nonempty(prop.expression)) { fail("Missing active inverse-rig expression: " + fields[i]); }
            var canonical = String(prop.expression).replace(/\s/g, "").replace(/'/g, '"').replace(/;+$/, "");
